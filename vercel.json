{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev --prefix Client",
  "buildCommand": "npm run build:vercel --prefix Client",
  "outputDirectory": "Client/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
