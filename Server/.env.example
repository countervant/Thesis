# Copy this file to .env and replace the values with your local secrets.
# Never commit the resulting .env file.

# MongoDB Atlas connection string, including database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a long random value, for example: openssl rand -base64 48
JWT_SECRET=<replace-with-a-long-random-secret>

# Optional local server port (defaults to 5000).
PORT=5000

# Optional: needed only when the frontend is hosted on another origin.
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
